import pandas as pd
import numpy as np
import tensorflow as tf
from tensorflow import keras

# --- 1. Data Generation and Preprocessing ---
def create_synthetic_dataset(num_rows=100):
    np.random.seed(42)
    data = {
        'participant_id': range(num_rows),
        'income': np.random.normal(loc=60000, scale=15000, size=num_rows).astype(int),
        'gender': np.random.choice(['Male', 'Female'], num_rows),
        'region': np.random.choice(['North', 'South', 'East', 'West'], num_rows),  # FIXED missing regions
    }
    df = pd.DataFrame(data)

    def true_ctr_arm_0(row):
        return 0.1 + (row['income'] / 150000) * 0.4 + (1 if row['gender'] == 'Male' and row['region'] == 'North' else 0) * 0.2
    
    def true_ctr_arm_1(row):
        return 0.1 + (row['income'] / 200000) * 0.3 + (1 if row['gender'] == 'Female' and row['region'] == 'South' else 0) * 0.3
    
    def true_ctr_arm_2(row):
        return 0.1 + (row['income'] / 100000) * 0.5 + (1 if row['region'] == 'West' else 0) * 0.1

    df['true_ctr_arm_0'] = df.apply(true_ctr_arm_0, axis=1).clip(0, 1)
    df['true_ctr_arm_1'] = df.apply(true_ctr_arm_1, axis=1).clip(0, 1)
    df['true_ctr_arm_2'] = df.apply(true_ctr_arm_2, axis=1).clip(0, 1)
    
    return df

def preprocess_data(df):
    df_encoded = pd.get_dummies(df, columns=['gender', 'region'], dtype=int)
    df_encoded['income'] = (df_encoded['income'] - df_encoded['income'].min()) / (df_encoded['income'].max() - df_encoded['income'].min())
    context_features = df_encoded.drop(columns=['participant_id', 'true_ctr_arm_0', 'true_ctr_arm_1', 'true_ctr_arm_2'])
    true_ctrs = df_encoded[['true_ctr_arm_0', 'true_ctr_arm_1', 'true_ctr_arm_2']]
    return context_features, true_ctrs

# --- 2. Neural Network Architecture ---
def build_cmab_model(input_dim, num_arms):
    model = keras.Sequential([
        keras.layers.Dense(16, activation="relu", input_shape=(input_dim,)),
        keras.layers.Dense(num_arms, activation="sigmoid")
    ])
    return model

# --- 3. Epsilon-Greedy Policy ---
def epsilon_greedy_policy(model, context, epsilon, num_arms):
    if np.random.rand() < epsilon:
        return np.random.randint(num_arms), "exploration (random choice)"
    else:
        predicted_rewards = model(context)
        return tf.argmax(predicted_rewards, axis=1).numpy()[0], "exploitation (highest predicted reward)"

# --- 4. Main Training and Simulation Loop ---
def run_simulation(context_features, true_ctrs, model, optimizer, num_iterations=100):
    num_arms = true_ctrs.shape[1]
    cumulative_reward = 0
    
    print("Starting CMAB simulation...")
    print("----------------------------")
    
    for i in range(num_iterations):
        context = tf.constant(context_features.iloc[i:i+1].values, dtype=tf.float32)
        epsilon = 1.0 / (i + 1)  # Decay epsilon

        # Choose action
        chosen_action, reason = epsilon_greedy_policy(model, context, epsilon, num_arms)

        # Get true CTR for that action
        true_ctr = true_ctrs.iloc[i, chosen_action]

        # Bernoulli sample
        reward = np.random.binomial(1, true_ctr)

        # Update model
        with tf.GradientTape() as tape:
            predictions = model(context)
            chosen_action_one_hot = tf.one_hot([chosen_action], num_arms, dtype=tf.float32)
            custom_target = predictions * (1 - chosen_action_one_hot) + (reward * chosen_action_one_hot)
            loss = tf.reduce_mean(tf.square(custom_target - predictions))
        gradients = tape.gradient(loss, model.trainable_weights)
        optimizer.apply_gradients(zip(gradients, model.trainable_weights))

        cumulative_reward += reward

        # ---- PRINT REASONING ----
        print(f"\nIteration {i+1}")
        print(f"Context (features): {context.numpy()}")
        print(f"Predicted rewards: {predictions.numpy().round(3)}")
        print(f"True CTRs: {true_ctrs.iloc[i].values.round(3)}")
        print(f"Epsilon: {epsilon:.3f}")
        print(f"Chosen action: {chosen_action} --> {reason}")
        print(f"Bernoulli sample from p={true_ctr:.3f} --> Reward: {reward}")
        print(f"Cumulative reward: {cumulative_reward}")

    print("----------------------------")
    print(f"Simulation finished. Total cumulative reward: {cumulative_reward}")
    return cumulative_reward

# --- Main execution ---
if __name__ == "__main__":
    num_rows = 20
    num_arms = 3
    
    raw_df = create_synthetic_dataset(num_rows)
    context_features, true_ctrs = preprocess_data(raw_df)
    
    input_dim = context_features.shape[1]
    cmab_model = build_cmab_model(input_dim, num_arms)
    optimizer = keras.optimizers.Adam(learning_rate=0.01)
    
    final_reward_cmab = run_simulation(context_features, true_ctrs, cmab_model, optimizer, num_rows)
    
    random_policy_reward = np.sum([np.random.binomial(1, true_ctrs.iloc[i, np.random.randint(num_arms)]) for i in range(num_rows)])
    print(f"\nRandom Policy (Baseline) Total Reward: {random_policy_reward}")



